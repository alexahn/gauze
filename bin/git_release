#!/bin/zsh

cp -r ./env/release/before/src/. ./src/
cp -r ./env/release/before/test/. ./test/

npx gauze delete gauze ./src ./gauze/gauze.js

npx gauze delete entity ./src ./gauze/entity.js

npx gauze delete entity ./src ./gauze/ytitne.js

npx gauze delete gauze ./src ./gauze/ezuag.js

rm ./src/database/migrations/00000000000012_ezuag.js
rm ./src/database/migrations/00000000000013_ytitne.js
rm ./src/database/migrations/00000000000014_entity.js
rm ./src/database/migrations/00000000000015_gauze.js

rm ./src/database/environment_development_monolithic_config.js
rm ./src/database/environment_development_sharded_config.js
rm ./src/database/environment_test_monolithic_config.js
rm ./src/database/environment_test_sharded_config.js

cp -r ./env/release/after/src/. ./src/
cp -r ./env/release/after/test/. ./test/
